# Wattbike Logger — permessi UNIVERSALI chiavette ANT+ (VID 0fcf, qualsiasi PID)
#
# Installed to /etc/udev/rules.d/42-ant-usb-sticks.rules

ACTION!="add", GOTO="wattbike_ant_rules_end"
SUBSYSTEM!="usb", GOTO="wattbike_ant_rules_end"

# Qualsiasi stick Dynastream/Garmin/Suunto ANT (non solo PID noti)
ATTR{idVendor}=="0fcf", ENV{ID_ANT_DEVICE}="1", TAG+="uaccess", GROUP="plugdev", MODE="0666"

LABEL="wattbike_ant_rules_end"
